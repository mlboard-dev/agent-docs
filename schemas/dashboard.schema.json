{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mlboard.dashboard/v1",
  "description": "Structural schema plus fixture options for timeseries/table/html. Every other plugin options object must additionally pass its registry schema; layout/reference constraints need semantic validation.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "mlboard.dashboard/v1"
    },
    "dashboard_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "selection": {
      "$ref": "query.schema.json#/$defs/selector"
    },
    "queries": {
      "type": "object",
      "patternProperties": {
        "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$": {
          "$ref": "query.schema.json"
        }
      },
      "additionalProperties": false
    },
    "panels": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/panel"
      },
      "maxItems": 1000
    },
    "layout": {
      "type": "object",
      "properties": {
        "columns": {
          "const": 12
        },
        "row_height": {
          "type": "integer",
          "minimum": 8,
          "maximum": 128
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/position"
          },
          "maxItems": 1000
        }
      },
      "required": [
        "columns",
        "row_height",
        "items"
      ],
      "additionalProperties": false
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/section"
      },
      "maxItems": 1000
    },
    "view": {
      "$ref": "#/$defs/view"
    }
  },
  "required": [
    "schema_version",
    "dashboard_id",
    "project_id",
    "title",
    "selection",
    "queries",
    "panels",
    "layout"
  ],
  "additionalProperties": false,
  "$defs": {
    "panel": {
      "type": "object",
      "properties": {
        "panel_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "type": {
          "enum": [
            "timeseries",
            "bar",
            "histogram",
            "distribution",
            "confusion_matrix",
            "roc",
            "precision_recall",
            "scatter",
            "parallel_coordinates",
            "boxplot",
            "table",
            "image",
            "text",
            "audio",
            "video",
            "embedding",
            "html"
          ]
        },
        "plugin_version": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "query_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "minItems": 0,
          "maxItems": 20,
          "uniqueItems": true
        },
        "options": {
          "type": "object"
        },
        "section_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        }
      },
      "required": [
        "panel_id",
        "title",
        "type",
        "plugin_version",
        "query_refs",
        "options"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "timeseries"
              }
            }
          },
          "then": {
            "properties": {
              "options": {
                "type": "object",
                "properties": {
                  "x_axis": {
                    "enum": [
                      "step",
                      "epoch",
                      "wall_time",
                      "elapsed_seconds",
                      "processed_samples",
                      "session_elapsed_seconds"
                    ]
                  },
                  "y_axis": {
                    "type": "object",
                    "properties": {
                      "scale": {
                        "enum": [
                          "linear",
                          "log"
                        ]
                      },
                      "unit": {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "enum": [
                              "dimensionless",
                              "ratio",
                              "percent",
                              "count",
                              "seconds",
                              "milliseconds",
                              "bytes",
                              "custom"
                            ]
                          },
                          "symbol": {
                            "type": "string",
                            "maxLength": 32
                          }
                        },
                        "required": [
                          "kind"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "scale"
                    ],
                    "additionalProperties": false
                  },
                  "legend": {
                    "type": "boolean"
                  },
                  "smoothing": {
                    "type": "object",
                    "properties": {
                      "method": {
                        "enum": [
                          "none",
                          "ema"
                        ]
                      },
                      "alpha": {
                        "type": "number",
                        "minimum": 0.001,
                        "maximum": 1
                      }
                    },
                    "required": [
                      "method"
                    ],
                    "additionalProperties": false,
                    "allOf": [
                      {
                        "if": {
                          "properties": {
                            "method": {
                              "const": "ema"
                            }
                          }
                        },
                        "then": {
                          "required": [
                            "alpha"
                          ]
                        },
                        "else": {
                          "properties": {
                            "alpha": false
                          }
                        }
                      }
                    ]
                  }
                },
                "required": [
                  "x_axis",
                  "y_axis",
                  "legend",
                  "smoothing"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "table"
              }
            }
          },
          "then": {
            "properties": {
              "options": {
                "type": "object",
                "properties": {
                  "columns": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1,
                    "uniqueItems": true
                  },
                  "page_size": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000
                  }
                },
                "required": [
                  "columns",
                  "page_size"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "html"
              }
            }
          },
          "then": {
            "properties": {
              "options": {
                "type": "object",
                "properties": {
                  "artifact_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                  },
                  "artifact_version": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]{0,18})$",
                    "description": "Nonnegative signed-63-bit decimal string. Semantic validator must also enforce <=9223372036854775807."
                  },
                  "artifact_digest": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  },
                  "capabilities": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "query_ref": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128,
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                        },
                        "fields": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          },
                          "minItems": 1,
                          "uniqueItems": true,
                          "maxItems": 64
                        },
                        "max_rows": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 10000
                        }
                      },
                      "required": [
                        "query_ref",
                        "fields",
                        "max_rows"
                      ],
                      "additionalProperties": false
                    },
                    "minItems": 0,
                    "maxItems": 20
                  },
                  "html": {
                    "type": "string",
                    "maxLength": 65536,
                    "description": "Inline source, isolated under the same renderer and capability rules as an immutable artifact. UTF-8 byte budget additionally enforced by server."
                  }
                },
                "required": [
                  "capabilities"
                ],
                "additionalProperties": false,
                "oneOf": [
                  {
                    "required": [
                      "artifact_id",
                      "artifact_version",
                      "artifact_digest"
                    ],
                    "properties": {
                      "html": false
                    }
                  },
                  {
                    "required": [
                      "html"
                    ],
                    "properties": {
                      "artifact_id": false,
                      "artifact_version": false,
                      "artifact_digest": false
                    }
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "position": {
      "type": "object",
      "properties": {
        "panel_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 11
        },
        "y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "w": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "h": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      },
      "required": [
        "panel_id",
        "x",
        "y",
        "w",
        "h"
      ],
      "additionalProperties": false
    },
    "section": {
      "type": "object",
      "properties": {
        "section_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "collapsed_by_default": {
          "type": "boolean"
        }
      },
      "required": [
        "section_id",
        "title",
        "collapsed_by_default"
      ],
      "additionalProperties": false
    },
    "view": {
      "type": "object",
      "properties": {
        "group_by": {
          "enum": [
            "manual",
            "metric_prefix"
          ]
        },
        "metric_prefix_depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "presentation": {
          "type": "object",
          "properties": {
            "schema_version": {
              "const": "mlboard.view-presentation/v1"
            },
            "display": {
              "type": "object",
              "properties": {
                "auto_layout": {
                  "type": "boolean"
                },
                "card_width": {
                  "type": "integer",
                  "minimum": 240,
                  "maximum": 960
                },
                "card_height": {
                  "type": "integer",
                  "minimum": 240,
                  "maximum": 800
                },
                "notation": {
                  "enum": [
                    "auto",
                    "standard",
                    "scientific"
                  ]
                },
                "decimals": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10
                },
                "panels_per_page": {
                  "enum": [
                    3,
                    6,
                    12,
                    24
                  ]
                },
                "rows_per_page": {
                  "enum": [
                    1,
                    2,
                    3,
                    4,
                    6
                  ]
                }
              },
              "required": [
                "auto_layout",
                "card_width",
                "card_height",
                "notation",
                "decimals"
              ],
              "additionalProperties": false
            },
            "panel_filter": {
              "type": "string",
              "maxLength": 1024
            },
            "shared_cursor": {
              "type": "boolean"
            },
            "section_states": {
              "type": "object",
              "maxProperties": 200,
              "propertyNames": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "additionalProperties": {
                "type": "boolean"
              }
            },
            "panels": {
              "type": "object",
              "maxProperties": 100,
              "propertyNames": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "show_raw": {
                    "type": "boolean"
                  },
                  "tooltip_sort": {
                    "enum": [
                      "value",
                      "name"
                    ]
                  },
                  "expanded": {
                    "type": "boolean"
                  },
                  "interaction": {
                    "type": "object",
                    "properties": {
                      "schema_version": {
                        "const": "mlboard.plot-interaction/v1"
                      },
                      "axis": {
                        "enum": [
                          "step",
                          "epoch",
                          "elapsed_seconds",
                          "wall_time",
                          "session_elapsed_seconds",
                          "processed_samples"
                        ]
                      },
                      "y_scale": {
                        "enum": [
                          "linear",
                          "log"
                        ]
                      },
                      "x_range": {
                        "type": "object",
                        "properties": {
                          "gte": {
                            "type": [
                              "string",
                              "number"
                            ]
                          },
                          "lte": {
                            "type": [
                              "string",
                              "number"
                            ]
                          }
                        },
                        "required": [
                          "gte",
                          "lte"
                        ],
                        "additionalProperties": false
                      },
                      "y_range": {
                        "type": "object",
                        "properties": {
                          "gte": {
                            "type": "number"
                          },
                          "lte": {
                            "type": "number"
                          }
                        },
                        "required": [
                          "gte",
                          "lte"
                        ],
                        "additionalProperties": false
                      },
                      "solo": {
                        "type": "string",
                        "maxLength": 8192
                      },
                      "hidden": {
                        "type": "array",
                        "maxItems": 2000,
                        "uniqueItems": true,
                        "items": {
                          "type": "string",
                          "maxLength": 8192
                        }
                      }
                    },
                    "required": [
                      "schema_version",
                      "axis",
                      "y_scale"
                    ],
                    "additionalProperties": false
                  },
                  "pinned": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "show_raw",
                  "tooltip_sort"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "schema_version",
            "display",
            "panel_filter"
          ],
          "additionalProperties": false
        },
        "analysis": {
          "type": "object",
          "properties": {
            "schema_version": {
              "const": "mlboard.compare/v1"
            },
            "stat": {
              "enum": [
                "last",
                "min",
                "max"
              ]
            },
            "diff_only": {
              "type": "boolean"
            },
            "directions": {
              "type": "object",
              "maxProperties": 200,
              "propertyNames": {
                "type": "string",
                "minLength": 10,
                "maxLength": 8192,
                "pattern": "^field:v1:"
              },
              "additionalProperties": {
                "enum": [
                  "up",
                  "down"
                ]
              }
            },
            "visible_fields": {
              "type": "array",
              "maxItems": 200,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 10,
                "maxLength": 8192,
                "pattern": "^field:v1:"
              }
            },
            "baseline": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "properties": {
                    "run_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "run_incarnation": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    }
                  },
                  "required": [
                    "run_id",
                    "run_incarnation"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "required": [
            "schema_version",
            "stat",
            "diff_only",
            "directions",
            "baseline"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "group_by",
        "metric_prefix_depth"
      ],
      "additionalProperties": false
    }
  }
}
