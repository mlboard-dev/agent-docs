{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mlboard.query-result/v1",
  "description": "Envelope schema; frame-specific types, finite/null states, field projections and equal column lengths additionally validated by registry/application.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "mlboard.query-result/v1"
    },
    "query_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "description": "Optional diagnostic copy; HTTP always supplies X-Request-ID."
    },
    "result_etag": {
      "type": "string"
    },
    "unchanged": {
      "type": "boolean"
    },
    "complete": {
      "type": "boolean"
    },
    "consistency": {
      "type": "object",
      "properties": {
        "snapshot_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "expires_at": {
          "type": "string"
        },
        "resolved_runs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "run_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
              },
              "run_path": {
                "type": "string"
              },
              "run_version": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,18})$",
                "description": "Nonnegative signed-63-bit decimal string. Semantic validator must also enforce <=9223372036854775807."
              },
              "data_revision": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,18})$",
                "description": "Nonnegative signed-63-bit decimal string. Semantic validator must also enforce <=9223372036854775807."
              },
              "summary_revision": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,18})$",
                "description": "Nonnegative signed-63-bit decimal string. Semantic validator must also enforce <=9223372036854775807."
              },
              "project_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
              },
              "run_incarnation": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
              }
            },
            "required": [
              "run_id",
              "run_version",
              "data_revision",
              "summary_revision"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "snapshot_id",
        "expires_at",
        "resolved_runs"
      ],
      "additionalProperties": false
    },
    "applied": {
      "type": "object"
    },
    "frames": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "frame_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "kind": {
            "enum": [
              "scalar",
              "histogram",
              "confusion_matrix",
              "curve",
              "table",
              "media",
              "embedding",
              "window"
            ]
          },
          "row_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 250000
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "type": {
                  "enum": [
                    "string",
                    "int64",
                    "float64",
                    "datetime",
                    "boolean",
                    "enum",
                    "event_ref",
                    "struct"
                  ]
                },
                "nullable": {
                  "type": "boolean"
                },
                "unit": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "enum": [
                        "dimensionless",
                        "ratio",
                        "percent",
                        "count",
                        "seconds",
                        "milliseconds",
                        "bytes",
                        "custom"
                      ]
                    },
                    "symbol": {
                      "type": "string",
                      "maxLength": 32
                    }
                  },
                  "required": [
                    "kind"
                  ],
                  "additionalProperties": false
                },
                "values": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "schema_ref": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_.-]*/v[1-9][0-9]*$",
                  "description": "Logical schema ID resolved only through the installed registry schema_catalog; never a fetchable URL."
                }
              },
              "required": [
                "name",
                "type",
                "nullable"
              ],
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "struct"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "schema_ref"
                    ]
                  },
                  "else": {
                    "properties": {
                      "schema_ref": false
                    }
                  }
                }
              ]
            },
            "minItems": 1
          },
          "columns": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {}
            },
            "properties": {
              "elapsed_seconds": {
                "type": "array",
                "items": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0
                },
                "description": "For scalar frames: original recorded Run-relative elapsed time in seconds, nullable when not recorded; independent of the selected X axis and never inferred from sampled endpoints."
              }
            }
          },
          "meta": {
            "type": "object"
          }
        },
        "required": [
          "frame_id",
          "kind",
          "row_count",
          "fields",
          "columns",
          "meta"
        ],
        "additionalProperties": false
      },
      "maxItems": 2000
    },
    "diagnostics": {
      "type": "object",
      "properties": {
        "truncated_by": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missing": {
          "type": "array",
          "items": {}
        },
        "stale_summaries": {
          "type": "array",
          "items": {}
        },
        "scanned_points": {
          "type": "integer",
          "minimum": 0
        },
        "merged_points": {
          "type": "integer",
          "minimum": 0
        },
        "dropped_source_events": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$",
          "description": "Nonnegative signed-63-bit decimal string. Semantic validator must also enforce <=9223372036854775807."
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "truncated_by",
        "missing",
        "stale_summaries",
        "scanned_points",
        "merged_points",
        "dropped_source_events",
        "warnings"
      ],
      "additionalProperties": false
    },
    "page": {
      "type": "object",
      "properties": {
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "returned_rows": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "next_cursor",
        "returned_rows"
      ],
      "additionalProperties": false
    },
    "reuse": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "schema_version": {
              "const": "mlboard.frame-reuse/v1"
            },
            "token": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "mode": {
              "const": "reset"
            },
            "row_ids": {
              "type": "object",
              "maxProperties": 2000,
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "uniqueItems": true,
                "maxItems": 10000
              }
            }
          },
          "required": [
            "schema_version",
            "mode",
            "token",
            "row_ids"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "schema_version": {
              "const": "mlboard.frame-reuse/v1"
            },
            "token": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "mode": {
              "const": "delta"
            },
            "base_token": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "patches": {
              "type": "array",
              "maxItems": 2000,
              "items": {
                "type": "object",
                "properties": {
                  "frame": {
                    "type": "object",
                    "properties": {
                      "frame_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                      },
                      "kind": {
                        "enum": [
                          "scalar",
                          "histogram",
                          "confusion_matrix",
                          "curve",
                          "table",
                          "media",
                          "embedding",
                          "window"
                        ]
                      },
                      "row_count": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 250000
                      },
                      "fields": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "name": {
                              "type": "string",
                              "minLength": 1
                            },
                            "type": {
                              "enum": [
                                "string",
                                "int64",
                                "float64",
                                "datetime",
                                "boolean",
                                "enum",
                                "event_ref",
                                "struct"
                              ]
                            },
                            "nullable": {
                              "type": "boolean"
                            },
                            "unit": {
                              "type": "object",
                              "properties": {
                                "kind": {
                                  "enum": [
                                    "dimensionless",
                                    "ratio",
                                    "percent",
                                    "count",
                                    "seconds",
                                    "milliseconds",
                                    "bytes",
                                    "custom"
                                  ]
                                },
                                "symbol": {
                                  "type": "string",
                                  "maxLength": 32
                                }
                              },
                              "required": [
                                "kind"
                              ],
                              "additionalProperties": false
                            },
                            "values": {
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            },
                            "schema_ref": {
                              "type": "string",
                              "pattern": "^[a-z][a-z0-9_.-]*/v[1-9][0-9]*$",
                              "description": "Logical schema ID resolved only through the installed registry schema_catalog; never a fetchable URL."
                            }
                          },
                          "required": [
                            "name",
                            "type",
                            "nullable"
                          ],
                          "additionalProperties": false,
                          "allOf": [
                            {
                              "if": {
                                "properties": {
                                  "type": {
                                    "const": "struct"
                                  }
                                }
                              },
                              "then": {
                                "required": [
                                  "schema_ref"
                                ]
                              },
                              "else": {
                                "properties": {
                                  "schema_ref": false
                                }
                              }
                            }
                          ]
                        },
                        "minItems": 1
                      },
                      "meta": {
                        "type": "object"
                      }
                    },
                    "required": [
                      "frame_id",
                      "kind",
                      "row_count",
                      "fields",
                      "meta"
                    ],
                    "additionalProperties": false
                  },
                  "columns": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 32,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    }
                  },
                  "order": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "uniqueItems": true,
                    "maxItems": 10000
                  },
                  "remove": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "uniqueItems": true,
                    "maxItems": 10000
                  },
                  "upsert": {
                    "type": "array",
                    "maxItems": 10000,
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128
                        },
                        "values": {
                          "type": "array",
                          "maxItems": 32,
                          "items": {}
                        }
                      },
                      "required": [
                        "id",
                        "values"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "frame",
                  "columns",
                  "order",
                  "remove",
                  "upsert"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "schema_version",
            "mode",
            "token",
            "base_token",
            "patches"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "query_id",
    "result_etag",
    "unchanged",
    "complete",
    "consistency",
    "applied",
    "frames",
    "diagnostics",
    "page"
  ],
  "additionalProperties": false
}
