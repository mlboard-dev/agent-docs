{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MLBoard bounded text, table and media payloads",
  "$defs": {
    "text": {
      "type": "object",
      "properties": {"schema_version": {"const": "mlboard.text/v1"}, "text": {"type": "string", "maxLength": 262144}},
      "required": ["schema_version", "text"],
      "additionalProperties": false
    },
    "table": {
      "type": "object",
      "properties": {
        "schema_version": {"const": "mlboard.table/v1"},
        "columns": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
        "rows": {"type": "array", "maxItems": 10000, "items": {"type": "array", "maxItems": 128}}
      },
      "required": ["schema_version", "columns", "rows"],
      "additionalProperties": false
    },
    "media": {
      "type": "object",
      "properties": {
        "schema_version": {"const": "mlboard.media/v1"},
        "artifact_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "media_type": {"type": "string", "minLength": 1, "maxLength": 64},
        "caption": {"type": "string", "maxLength": 4096}
      },
      "required": ["schema_version", "artifact_id", "media_type"],
      "additionalProperties": false
    }
  }
}
