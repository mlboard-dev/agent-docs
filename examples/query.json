{
  "schema_version": "mlboard.query/v1",
  "runs": {
    "run_ids": [
      "run_REPLACE"
    ],
    "run_incarnations": {
      "run_REPLACE": "inc_REPLACE"
    }
  },
  "source": {
    "kind": "scalar",
    "metrics": [
      {
        "name": "train/loss",
        "context": {}
      }
    ]
  },
  "x": {
    "field": "step"
  },
  "read": {
    "producers": {
      "mode": "primary"
    },
    "sessions": {
      "mode": "all"
    },
    "duplicate_steps": "latest_logical"
  },
  "transform": {
    "kind": "downsample",
    "algorithm": "min_max",
    "algorithm_version": "1",
    "points_per_series": 800
  },
  "page": {
    "limit": 1000
  },
  "budget": {
    "max_runs": 1,
    "max_series": 1,
    "max_points": 1000,
    "max_points_per_series": 800,
    "max_scanned_points": 10000000,
    "max_bytes": 8388608,
    "on_exceed": "error"
  }
}
